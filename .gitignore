# Secrets — NEVER commit. Contains SYNAPSE_CONN_STR and ANTHROPIC_API_KEY.
.env
.env.*
!.env.example

# Business data — internal Tricentis GTM figures. Not for any remote.
data/
*.xlsm
*.xlsx
*.parquet
Target_Monthly.csv
# Notebooks are copies of the owner's internal models and carry executed
# output cells with real figures. Read them in place; never commit one.
*.ipynb

# Pipeline outputs, run lineage, and generated exports.
# workspace/runs/ holds real GTM figures — never commit.
output/
workspace/exports/
workspace/runs/
# Ephemeral thinking. Scripts written, run, read and deleted — nothing here is
# durable, and a leftover is disposable rather than a work product.
workspace/scratch/*
!workspace/scratch/README.md

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Local tooling
.remember/
